{
  "name": "meshlib",
  "version": "3.1.3.297",
  "port-version": 3,
  "description": "Mesh processing library",
  "homepage": "https://meshlib.io/",
  "license": null,
  "supports": "!(x86 | arm32)",
  "dependencies": [
    "boost",
    "eigen3",
    "fmt",
    "jsoncpp",
    "libzip",
    "parallel-hashmap",
    "spdlog",
    "tbb",
    "tl-expected",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib-ng"
  ],
  "features": {
    "symbolmesh": {
      "description": "Build the MRSymbolMesh library to generate meshes from text/strings (uses Freetype)",
      "dependencies": [
        "freetype"
      ]
    }
  }
}
