
get_filename_component(_cmigemo_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

find_library(MIGEMO_LIBRARY NAMES migemo PATHS "${_cmigemo_prefix}/lib" NO_DEFAULT_PATH)

add_library(cmigemo::migemo INTERFACE IMPORTED)
set_property(TARGET cmigemo::migemo PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_cmigemo_prefix}/include")
set_property(TARGET cmigemo::migemo PROPERTY INTERFACE_LINK_LIBRARIES "${MIGEMO_LIBRARY}")
