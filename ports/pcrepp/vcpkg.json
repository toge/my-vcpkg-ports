{
  "name": "pcrepp",
  "version": "2026-08-25",
  "description": "A lightweight C++20 wrapper for PCRE2",
  "homepage": "https://github.com/toge/pcrepp",
  "license": "MIT",
  "dependencies": [
    "fast-float",
    "pcre2",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "ctre": {
      "description": "Enable CTRE delegate",
      "dependencies": [
        "ctre"
      ]
    },
    "glaze": {
      "description": "Enable glaze reflection",
      "dependencies": [
        "glaze"
      ]
    }
  }
}
