{
  "name": "openrasterpp",
  "version-date": "2026-09-06",
  "description": "C++ library for reading and writing OpenRaster images",
  "homepage": "https://github.com/toge/openrasterpp",
  "license": "MIT",
  "dependencies": [
    "minizip-ng",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "libspng"
  ],
  "features": {
    "fpng": {
      "description": "Enable fpng backend",
      "dependencies": [
        "fpng"
      ]
    },
    "libpng": {
      "description": "Enable libpng backend",
      "dependencies": [
        "libpng"
      ]
    },
    "libspng": {
      "description": "Enable libspng backend",
      "dependencies": [
        "libspng"
      ]
    },
    "loadpng": {
      "description": "Enable lodepng backend",
      "dependencies": [
        "lodepng"
      ]
    },
    "stb": {
      "description": "Enable stb backend",
      "dependencies": [
        "stb"
      ]
    }
  }
}
