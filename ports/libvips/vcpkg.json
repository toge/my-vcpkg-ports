{
  "name": "libvips",
  "version": "8.18.3",
  "description": "A fast image processing library with low memory needs.",
  "homepage": "https://www.libvips.org/",
  "license": "LGPL-2.1-or-later",
  "supports": "!uwp",
  "dependencies": [
    "expat",
    "glib",
    {
      "name": "vcpkg-tool-meson",
      "host": true
    }
  ],
  "features": {
    "analyze": {
      "description": "Build with analyze loader"
    },
    "archive": {
      "description": "Build with libarchive",
      "dependencies": [
        "libarchive"
      ]
    },
    "cfitsio": {
      "description": "Build with cfitsio",
      "dependencies": [
        "cfitsio"
      ]
    },
    "cpp": {
      "description": "Build C++ API"
    },
    "exif": {
      "description": "Build with exif support",
      "dependencies": [
        "libexif"
      ]
    },
    "fontconfig": {
      "description": "Build with fontconfig support",
      "dependencies": [
        "fontconfig"
      ]
    },
    "heif": {
      "description": "Build with libheif support",
      "dependencies": [
        "libheif"
      ]
    },
    "highway": {
      "description": "Build with highway",
      "dependencies": [
        "highway"
      ]
    },
    "jpeg": {
      "description": "Build with JPEG support",
      "dependencies": [
        "libjpeg-turbo"
      ]
    },
    "jpeg-xl": {
      "description": "Build with JPEG XL support",
      "dependencies": [
        "libjxl"
      ]
    },
    "lcms": {
      "description": "Build with LCMS2 support",
      "dependencies": [
        "lcms"
      ]
    },
    "matio": {
      "description": "Build with MATIO support",
      "dependencies": [
        "matio"
      ]
    },
    "nifti": {
      "description": "Build with NIFTI support",
      "dependencies": [
        "nifticlib"
      ]
    },
    "nsgif": {
      "description": "Build with nsgif loader"
    },
    "openexr": {
      "description": "Build with OpenEXR support",
      "dependencies": [
        "openexr"
      ]
    },
    "openjpeg": {
      "description": "Build with OpenJPEG support",
      "dependencies": [
        "openjpeg"
      ]
    },
    "openslide": {
      "description": "Build with OpenSlide support",
      "dependencies": [
        "openslide"
      ]
    },
    "orc": {
      "description": "Build with orc",
      "dependencies": [
        "orc"
      ]
    },
    "png": {
      "description": "Build with PNG support",
      "dependencies": [
        "libpng"
      ]
    },
    "poppler": {
      "description": "Build with poppler support",
      "dependencies": [
        {
          "name": "poppler",
          "features": [
            "glib"
          ]
        }
      ]
    },
    "ppm": {
      "description": "Build with ppm loader"
    },
    "radiance": {
      "description": "Build with radiance loader"
    },
    "rsvg": {
      "description": "Build with librsvg support",
      "dependencies": [
        "librsvg"
      ]
    },
    "spng": {
      "description": "Build with libspng support",
      "dependencies": [
        "libspng"
      ]
    },
    "tiff": {
      "description": "Build with TIFF support",
      "dependencies": [
        "tiff"
      ]
    },
    "webp": {
      "description": "Build with WebP support",
      "dependencies": [
        "libwebp"
      ]
    },
    "zlib": {
      "description": "Build with zlib support",
      "dependencies": [
        "zlib"
      ]
    }
  }
}
