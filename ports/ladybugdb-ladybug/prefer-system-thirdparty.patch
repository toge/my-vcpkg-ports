diff --git a/third_party/CMakeLists.txt b/third_party/CMakeLists.txt
index 5554d77..fbe4f1e 100644
--- a/third_party/CMakeLists.txt
+++ b/third_party/CMakeLists.txt
@@ -1,28 +1,90 @@
-if(NOT MSVC)
-    add_compile_options(-Wno-extra)
-endif()
+function(lbug_alias_imported alias source)
+    if(NOT TARGET ${alias})
+        if(TARGET ${source})
+            get_target_property(_src_type ${source} TYPE)
+            if(_src_type STREQUAL "INTERFACE_LIBRARY")
+                add_library(${alias} INTERFACE IMPORTED GLOBAL)
+                get_target_property(_inc ${source} INTERFACE_INCLUDE_DIRECTORIES)
+                if(_inc)
+                    set_property(TARGET ${alias} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
+                endif()
+                get_target_property(_link ${source} INTERFACE_LINK_LIBRARIES)
+                if(_link)
+                    set_property(TARGET ${alias} PROPERTY INTERFACE_LINK_LIBRARIES "${_link}")
+                endif()
+                return()
+            endif()
+        endif()
+        add_library(${alias} STATIC IMPORTED GLOBAL)
+    endif()
+    foreach(_suffix IN ITEMS "" _RELEASE _DEBUG _RELWITHDEBINFO _MINSIZEREL)
+        get_target_property(_loc ${source} IMPORTED_LOCATION${_suffix})
+        if(_loc)
+            set_property(TARGET ${alias} PROPERTY IMPORTED_LOCATION${_suffix} "${_loc}")
+        endif()
+    endforeach()
+endfunction()
 
