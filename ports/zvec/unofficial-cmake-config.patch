diff --git a/CMakeLists.txt b/CMakeLists.txt
index ea281fb..1747ad9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -275,6 +275,145 @@ if(BUILD_TOOLS)
     cc_directories(tools)
 endif()
 
+include(GNUInstallDirs)
+
+if(TARGET zvec_ailego)
+    set_property(TARGET zvec_ailego PROPERTY EXPORT_NAME ailego)
+endif()
+if(TARGET zvec_core)
+    set_property(TARGET zvec_core PROPERTY EXPORT_NAME core)
+endif()
+if(TARGET zvec)
+    set_property(TARGET zvec PROPERTY EXPORT_NAME zvec)
+    # cppjieba is header-only and not needed by consumers; remove from interface
+    get_target_property(_zv_links zvec INTERFACE_LINK_LIBRARIES)
+    if(_zv_links)
+        list(REMOVE_ITEM _zv_links cppjieba)
+        set_property(TARGET zvec PROPERTY INTERFACE_LINK_LIBRARIES ${_zv_links})
+    endif()
+    # Replace source-prefixed include dirs with install-relative paths
+    set_property(TARGET zvec PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+        "$<BUILD_INTERFACE:${PROJECT_ROOT_DIR}/src/include>"
+        "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
+    )
+endif()
+
+install(
+    TARGETS zvec_ailego zvec_core zvec_turbo zvec
+    EXPORT unofficial-zvec-targets
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
+
+# zvec_core がリンクする rabitqlib / rabitqlib_runtime も export set に含める
+if(TARGET rabitqlib)
+    install(TARGETS rabitqlib EXPORT unofficial-zvec-targets)
+endif()
+if(TARGET rabitqlib_runtime)
+    install(TARGETS rabitqlib_runtime EXPORT unofficial-zvec-targets
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    )
+endif()
+
+# snowball: EXCLUDE_FROM_ALL サブディレクトリ内の install() はトップレベル
+# install で実行されないため、ここからインストールする
+if(TARGET snowball)
+    install(TARGETS snowball EXPORT unofficial-zvec-targets
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    )
+    install(FILES ${PROJECT_ROOT_DIR}/thirdparty/snowball/snowball-3.1.1/include/libstemmer.h
+        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+    )
+endif()
+
+install(
+    DIRECTORY ${PROJECT_ROOT_DIR}/src/include/
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
+
+set(_zvec_config_file "${CMAKE_CURRENT_BINARY_DIR}/unofficial-zvec-config.cmake")
+file(WRITE "${_zvec_config_file}" [=[include(CMakeFindDependencyMacro)
+find_dependency(glog CONFIG)
+find_dependency(gflags CONFIG)
+find_dependency(roaring CONFIG)
+find_dependency(RocksDB CONFIG)
+find_dependency(Protobuf CONFIG)
+find_dependency(Arrow CONFIG)
+find_dependency(Parquet CONFIG)
+find_dependency(ArrowCompute CONFIG)
+find_dependency(ArrowAcero CONFIG)
+find_dependency(ArrowDataset CONFIG)
+find_dependency(FastPFOR CONFIG)
+# vcpkg の fastpfor port は不正な include パス "/fastpfor" を含むため除去
+if(TARGET FastPFOR::FastPFOR)
+    get_target_property(_zvec_fpinc FastPFOR::FastPFOR INTERFACE_INCLUDE_DIRECTORIES)
+    if(_zvec_fpinc)
+        list(REMOVE_ITEM _zvec_fpinc "/fastpfor")
+        set_target_properties(FastPFOR::FastPFOR PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_zvec_fpinc}")
+    endif()
+endif()
+find_dependency(sparsehash CONFIG)
+find_dependency(magic_enum CONFIG)
+find_dependency(utf8proc CONFIG)
+find_dependency(antlr4-runtime CONFIG)
+include("${CMAKE_CURRENT_LIST_DIR}/unofficial-zvec-targets.cmake")
+
+# consume-time fixup:
+# - devendoring が作るビルド時シムターゲット(Arrow::* 等のエイリアス)は
+#   export に生名で埋め込まれるが、シムは zvec ビルド内にしか存在しない。
+#   実際の vcpkg ターゲットへ置換する。
+# - sparsehash / magic_enum はヘッダオンリーポート(.a 無し)のため、
+#   生名のままリンクすると -lsparsehash で失敗する。名前空間付きへ置換。
+foreach(_zvec_imported_target
+        unofficial::zvec::zvec unofficial::zvec::core
+        unofficial::zvec::ailego unofficial::zvec::zvec_turbo)
+    if(TARGET ${_zvec_imported_target})
+        get_target_property(_zvec_ll ${_zvec_imported_target} INTERFACE_LINK_LIBRARIES)
+        if(_zvec_ll)
+            set(_zvec_ll_fixed "")
+            foreach(_zvec_item IN LISTS _zvec_ll)
+                if(_zvec_item STREQUAL "sparsehash")
+                    list(APPEND _zvec_ll_fixed "sparsehash::sparsehash")
+                elseif(_zvec_item STREQUAL "magic_enum")
+                    list(APPEND _zvec_ll_fixed "magic_enum::magic_enum")
+                elseif(_zvec_item STREQUAL "Arrow::parquet_static")
+                    list(APPEND _zvec_ll_fixed "Parquet::parquet_static")
+                elseif(_zvec_item STREQUAL "Arrow::arrow_compute")
+                    list(APPEND _zvec_ll_fixed "ArrowCompute::arrow_compute_static")
+                elseif(_zvec_item STREQUAL "Arrow::arrow_acero")
+                    list(APPEND _zvec_ll_fixed "ArrowAcero::arrow_acero_static")
+                elseif(_zvec_item STREQUAL "Arrow::arrow_dataset")
+                    list(APPEND _zvec_ll_fixed "ArrowDataset::arrow_dataset_static")
+                else()
+                    list(APPEND _zvec_ll_fixed "${_zvec_item}")
+                endif()
+            endforeach()
+            set_property(TARGET ${_zvec_imported_target} PROPERTY INTERFACE_LINK_LIBRARIES "${_zvec_ll_fixed}")
+        endif()
+        get_target_property(_zvec_inc ${_zvec_imported_target} INTERFACE_INCLUDE_DIRECTORIES)
+        if(_zvec_inc)
+            list(REMOVE_ITEM _zvec_inc "/fastpfor")
+            set_property(TARGET ${_zvec_imported_target} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_zvec_inc}")
+        endif()
+    endif()
+endforeach()
+]=])
+
+install(
+    FILES "${_zvec_config_file}"
+    DESTINATION "share/unofficial-zvec"
+)
+
+install(
+    EXPORT unofficial-zvec-targets
+    FILE unofficial-zvec-targets.cmake
+    NAMESPACE unofficial::zvec::
+    DESTINATION "share/unofficial-zvec"
+)
+
 set(CPACK_PACKAGE_VERSION ${ZVEC_VERSION_NUMBER})
 set(CPACK_PACKAGE_VERSION_MAJOR ${ZVEC_VERSION_MAJOR})
 set(CPACK_PACKAGE_VERSION_MINOR ${ZVEC_VERSION_MINOR})
