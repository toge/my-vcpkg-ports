diff --git a/thirdparty/thirdparty-external.cmake b/thirdparty/thirdparty-external.cmake
index a0de94a..429853c 100644
--- a/thirdparty/thirdparty-external.cmake
+++ b/thirdparty/thirdparty-external.cmake
@@ -27,7 +27,23 @@ macro (find_hdr_package PKG_NAME HDR_PATH)
 
     if(${PKG_NAME}_FOUND)
         if (NOT TARGET ${PKG_NAME})
-            imported_target_alias(${PKG_NAME} ALIAS "${PKG_NAME}::${PKG_NAME}")
+            if(TARGET nonstd::${PKG_NAME})
+                imported_target_alias(${PKG_NAME} ALIAS nonstd::${PKG_NAME})
+            elseif(TARGET ${PKG_NAME}::${PKG_NAME})
+                imported_target_alias(${PKG_NAME} ALIAS "${PKG_NAME}::${PKG_NAME}")
+            elseif("${PKG_NAME}" STREQUAL "fmt-header-only" AND TARGET fmt::fmt-header-only)
+                imported_target_alias(${PKG_NAME} ALIAS fmt::fmt-header-only)
+            elseif("${PKG_NAME}" STREQUAL "fmt-header-only" AND TARGET fmt::fmt)
+                imported_target_alias(${PKG_NAME} ALIAS fmt::fmt)
+            else()
+                message(WARNING "Package ${PKG_NAME} found but no known target; creating interface target")
+                if(NOT TARGET ${PKG_NAME})
+                    add_library(${PKG_NAME} INTERFACE)
+                    if(DEFINED ${PKG_NAME}_INCLUDE_DIR)
+                        target_include_directories(${PKG_NAME} INTERFACE "${${PKG_NAME}_INCLUDE_DIR}")
+                    endif()
+                endif()
+            endif()
         endif ()
     else()
         message(FATAL_ERROR "${PKG_NAME} not found!")
