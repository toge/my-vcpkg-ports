+)
+
+# libaio.a uses .symver directives. bfd ld needs a version script when
+# linking static libaio into a shared library. Generate one here.
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/libaio_version.script"
+    "LIBAIO_0.4 {\n    global:\n        io_*;\n};\n")
+target_link_options(core_knn_diskann PRIVATE
+    "-Wl,--version-script=${CMAKE_CURRENT_BINARY_DIR}/libaio_version.script")
