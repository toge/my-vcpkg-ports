{
  "name": "ladybugdb-ladybug",
  "version": "0.17.1",
  "port-version": 4,
  "description": "Ladybug is an embedded graph database built for query speed and scalability.",
  "homepage": "https://github.com/ladybugdb/ladybug",
  "license": "MIT",
  "dependencies": [
    "antlr4",
    {
      "name": "arrow",
      "features": [
        "parquet"
      ]
    },
    "brotli",
    "fast-float",
    "lz4",
    "mbedtls",
    "miniz",
    "p-ranav-glob",
    "re2",
    "roaring",
    "simsimd",
    "snappy",
    "thrift",
    "utf8proc",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "yyjson",
    "zstd"
  ],
  "features": {
    "shell": {
      "description": "Build Interactive Shell"
    }
  }
}
